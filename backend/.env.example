# =============================================================================
# ELVA Support — Backend environment (copy to .env for local dev)
# On Render: set these in Dashboard → Environment (never commit .env)
# =============================================================================

# --- Core ---
NODE_ENV=development
PORT=3000
# Optional build identity (Phase 14)
# APP_VERSION=1.0.0
# GIT_SHA=
# BUILD_TIMESTAMP=
# HEALTH_INCLUDE_VERSION=false

# --- Database ---
MONGODB_URI=mongodb://localhost:27017/elva-support-dev
# Migrations (intentional CLI only — not run on API startup):
#   npm run migrate:status | migrate:up | migrate:down
# Uses the same MONGODB_URI. See docs/phase-2-tenant-foundation.md
# Phase 14: no database migration required.

# --- Authentication ---
# Generate for production: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=24h
INTERNAL_API_KEY=change-this-internal-api-key-in-production

# --- Tenant resolution ---
TENANT_BASE_DOMAIN=elvasupport.in
PLATFORM_ADMIN_HOST=admin.elvasupport.in
TENANT_HEADER_OVERRIDE_ENABLED=true
TENANT_REJECT_HEADER_IN_PRODUCTION=true
# NEVER set in production
TENANT_DEV_DEFAULT_SLUG=elva

# --- Platform ---
# Used ONLY by: npm run ensure:platform-admin (not on API startup)
# PLATFORM_ADMIN_EMAIL=
# PLATFORM_ADMIN_PASSWORD=
# PLATFORM_ADMIN_NAME=Platform Super Admin

# --- CORS / Proxy ---
# Exact allowlist (comma-separated). Do NOT use * for authenticated APIs.
CORS_ALLOWED_ORIGINS=http://localhost:4200
# CORS_ORIGIN=http://localhost:4200
FRONTEND_URL=http://localhost:4200
API_BASE_URL=http://localhost:3000
CORS_ALLOW_TENANT_SUBDOMAINS=true
CORS_ALLOW_LOCALHOST=true
CORS_ALLOW_VERCEL_PREVIEWS=false
CORS_REQUIRE_HTTPS_SUBDOMAINS=true
# TRUST_PROXY: false default; set 1 behind Nginx/ALB/Cloudflare/Render (affects client IP + Host)
TRUST_PROXY=false

# --- Rate limiting (Phase 14) ---
# In-memory per process — suitable for single instance; use Redis later for multi-instance.
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
OTP_RATE_LIMIT_WINDOW_MS=900000
OTP_RATE_LIMIT_MAX=5
# Backward-compatible aliases:
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_LOGIN_MAX=10
# RATE_LIMIT_OTP_MAX=5

# --- Observability (Phase 14) ---
LOG_LEVEL=info
# json in production by default when LOG_FORMAT unset; use pretty for local readability
LOG_FORMAT=pretty
LOG_REQUESTS=true
LOG_HEALTH_REQUESTS=false
# Legacy morgan access logs (duplicates access log middleware — off by default)
LOG_MORGAN=false
# Optional Prometheus text at GET /metrics (requires X-Internal-Api-Key)
METRICS_ENDPOINT_ENABLED=false

# --- Shutdown / Runtime (Phase 14) ---
GRACEFUL_SHUTDOWN_TIMEOUT_MS=15000
# FATAL_ON_UNHANDLED_REJECTION=true
# ENSURE_ADMIN_ON_STARTUP=true

# --- Tenant provisioning / onboarding ---
TENANT_WORKSPACE_PROTOCOL=https
TENANT_ONBOARDING_PATH=/setup-account
TENANT_ADMIN_INVITATION_EXPIRY_HOURS=72

# --- Tenant Admin bootstrap (workspace ADMIN — NOT Platform Admin) ---
ADMIN_EMAIL=admin@elvatech.in
ADMIN_PASSWORD=change-me
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Administrator

# --- Email / Notifications ---
NOTIFICATION_PROVIDER=RESEND
RESEND_API_KEY=
RESEND_FROM_NAME=ELVA Support
RESEND_TIMEOUT_MS=15000
NOTIFICATION_FALLBACK_ENABLED=false
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_WORKER_POLL_MS=5000
NOTIFICATION_WORKER_BATCH_SIZE=10
EMAIL_SUPPORT_ADDRESS=support@elvatech.in
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tech.elva@gmail.com
SMTP_PASS=
SMTP_FROM_NAME=ELVA Support
SMTP_CONNECTION_TIMEOUT_MS=20000
SMTP_GREETING_TIMEOUT_MS=20000
SMTP_SOCKET_TIMEOUT_MS=30000

# --- Inbound email ---
EMAIL_INBOUND_ENABLED=true
EMAIL_INBOUND_PROVIDER=webhook
EMAIL_INBOUND_WEBHOOK_SECRET=
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_IMAP_SECURE=true
EMAIL_IMAP_USER=tech.elva@gmail.com
EMAIL_IMAP_PASSWORD=
EMAIL_IMAP_MAILBOX=support@elvatech.in
EMAIL_IMAP_POLL_MS=180000
EMAIL_IMAP_POLL_TIMEOUT_MS=90000
EMAIL_IMAP_CONNECTION_TIMEOUT_MS=30000
EMAIL_IMAP_GREETING_TIMEOUT_MS=15000
EMAIL_IMAP_SOCKET_TIMEOUT_MS=45000
EMAIL_IMAP_BATCH_SIZE=10
EMAIL_IMAP_LOOKBACK_DAYS=3

# --- ELVA Notify (optional) ---
ELVA_NOTIFY_API_URL=https://api.notify.elvatech.in
ELVA_NOTIFY_APP_ID=
ELVA_NOTIFY_API_KEY=
ELVA_NOTIFY_BRAND_ID=
ELVA_NOTIFY_OTP_MODE=relay
ELVA_NOTIFY_TIMEOUT_MS=10000

# --- OTP & merchant sessions ---
OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_LOCK_MINUTES=15
MERCHANT_SESSION_EXPIRES_HOURS=24
# Production: must be false (validate-env enforces)
LOG_OTP_TO_CONSOLE=false
EXPOSE_OTP_IN_RESPONSE=false

# --- Attachments ---
GOOGLE_DRIVE_MOCK=true
UPLOADS_DIR=uploads
UPLOAD_MAX_FILE_SIZE=10485760
GOOGLE_DRIVE_PARENT_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Dev / ops UI ---
LOG_VIEWER_ENABLED=true
LOG_VIEWER_REQUIRE_AUTH=true
