# =============================================================================
# ELVA Support — Render PRODUCTION environment template
# =============================================================================
# Copy these into Render → Service → Environment.
# Do NOT commit real secrets. Replace every REPLACE_ME / keep existing secrets.
#
# Your old env (support-system-env.env) worked for an earlier domain era.
# Multi-tenant production now REQUIRES tenant + security vars below.
# Missing TENANT_BASE_DOMAIN or LOG_OTP_TO_CONSOLE≠false → process exits → "CORS error"
# in the browser (API is down, not a Vercel CORS misconfig).
# =============================================================================

# --- Core (Render usually sets NODE_ENV=production) ---
NODE_ENV=production
PORT=3000
TRUST_PROXY=1

# --- Database (keep your Atlas URI) ---
MONGODB_URI=REPLACE_ME

# --- Auth (keep your existing production secrets) ---
JWT_SECRET=REPLACE_ME
JWT_EXPIRES_IN=7d
INTERNAL_API_KEY=REPLACE_ME

# --- Tenant / hostname (REQUIRED — was missing from your old Render env) ---
# Must match frontend environment.prod.ts tenantBaseDomain
TENANT_BASE_DOMAIN=elvasupport.in
PLATFORM_ADMIN_HOST=admin.elvasupport.in
TENANT_WORKSPACE_PROTOCOL=https
TENANT_ONBOARDING_PATH=/setup-account
TENANT_ADMIN_INVITATION_EXPIRY_HOURS=72
# Production hard rules — do NOT copy these from local .env:
TENANT_HEADER_OVERRIDE_ENABLED=false
TENANT_REJECT_HEADER_IN_PRODUCTION=true
# Leave TENANT_DEV_DEFAULT_SLUG UNSET in production (delete the key if present)

# --- CORS / URLs (update from old support.elvatech.in) ---
# Exact allowlist still required by validate-env; subdomain matcher covers *.elvasupport.in
CORS_ALLOWED_ORIGINS=https://elvasupport.in,https://www.elvasupport.in,https://admin.elvasupport.in
CORS_ALLOW_TENANT_SUBDOMAINS=true
CORS_ALLOW_LOCALHOST=false
CORS_ALLOW_VERCEL_PREVIEWS=true
CORS_REQUIRE_HTTPS_SUBDOMAINS=true
FRONTEND_URL=https://elvasupport.in
API_BASE_URL=https://support-system-qhjr.onrender.com

# --- Security / OTP (REQUIRED flips vs your old env) ---
LOG_OTP_TO_CONSOLE=false
EXPOSE_OTP_IN_RESPONSE=false
NOTIFICATION_FALLBACK_ENABLED=false
ENSURE_ADMIN_ON_STARTUP=false

# --- Rate limits ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_OTP_MAX=5
RATE_LIMIT_WINDOW_MS=900000
OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_LOCK_MINUTES=15
MERCHANT_SESSION_EXPIRES_HOURS=24

# --- Notifications (keep your Resend key) ---
NOTIFICATION_PROVIDER=RESEND
RESEND_API_KEY=REPLACE_ME
RESEND_FROM_NAME=ELVA Support
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_WORKER_POLL_MS=5000
NOTIFICATION_WORKER_BATCH_SIZE=10
EMAIL_SUPPORT_ADDRESS=support@elvatech.in

# SMTP optional when Resend is primary (safe to keep)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_ME
SMTP_PASS=REPLACE_ME
SMTP_FROM_NAME=ELVA Support

# --- Inbound email (keep if using Cloudflare worker) ---
EMAIL_INBOUND_ENABLED=true
EMAIL_INBOUND_PROVIDER=webhook
EMAIL_INBOUND_WEBHOOK_SECRET=REPLACE_ME
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_IMAP_SECURE=true
EMAIL_IMAP_USER=REPLACE_ME
EMAIL_IMAP_PASSWORD=REPLACE_ME
EMAIL_IMAP_MAILBOX=support@elvatech.in
EMAIL_IMAP_BATCH_SIZE=10
EMAIL_IMAP_LOOKBACK_DAYS=3
EMAIL_IMAP_POLL_MS=120000
EMAIL_IMAP_POLL_TIMEOUT_MS=120000

# --- Attachments ---
GOOGLE_DRIVE_MOCK=true
UPLOADS_DIR=uploads
UPLOAD_MAX_FILE_SIZE=10485760

# --- Ops ---
LOG_VIEWER_ENABLED=true
LOG_VIEWER_REQUIRE_AUTH=true
LOG_LEVEL=info
LOG_FORMAT=json
LOG_REQUESTS=true

# --- Platform admin bootstrap (optional; only for npm run ensure:platform-admin) ---
# PLATFORM_ADMIN_EMAIL=admin@elvatech.in
# PLATFORM_ADMIN_PASSWORD=REPLACE_ME
# PLATFORM_ADMIN_NAME=Platform Super Admin

# --- ELVA tenant admin bootstrap (optional; ENSURE_ADMIN_ON_STARTUP should stay false) ---
# ADMIN_EMAIL=arun.pn@elvatech.in
# ADMIN_PASSWORD=REPLACE_ME
# ADMIN_FIRST_NAME=System
# ADMIN_LAST_NAME=Administrator
